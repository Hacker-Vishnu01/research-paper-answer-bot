# Optional OpenAI API Configuration
# The production application uses local Ollama instead.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local LLM
# The application uses Llama 3.2 3B through Ollama.
LLM_MODEL=llama3.2:3b

# Vector Store Configuration
CHROMA_PERSIST_DIRECTORY=./data/processed/chroma_db

# Document Processing & Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval Configuration
# The production application retrieves 10 candidates and uses the top 3
# passages as final context.
RETRIEVAL_TOP_K=10
